# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
PER_IP_LIMIT=10
GLOBAL_DAILY_LIMIT=400
PER_USER_LIMIT=30
# Where accounts are stored (a small file next to app.py)
DB_PATH=doubtly.db

# --- Plans: free uses per month, then Pro ---
FREE_MONTHLY_USES=7
GUEST_MONTHLY_USES=2
PRO_MONTHLY_LIMIT=200
PRICE_INR=49
PRICE_USD=5
# Paste the payment links you create in Razorpay (India) and Stripe (dollars). Must start with https://
PAYMENT_LINK_INR=
PAYMENT_LINK_USD=
# Testing on your own computer only: lets any logged-in user get Pro free. NEVER set this to 1 online.
DEV_FREE_UPGRADE=0

# --- Doubtly AI chat: messages per day ---
CHAT_GUEST_PER_DAY=5
CHAT_FREE_PER_DAY=15
CHAT_PRO_PER_DAY=100

# Password reset emails (optional). Without these, the reset link is printed in the black window.
# Your website address, used inside the email link (for example https://doubtly.onrender.com):
PUBLIC_URL=
# Any email service that gives you SMTP details (Gmail app password, Brevo free plan, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Keep accounts safe on free hosts: paste the address of a free Postgres database (optional).
# Looks like: postgresql://user:password@host/dbname
DATABASE_URL=
# Reset emails over the web (works on free hosts). Brevo has a free plan. SMTP_FROM must be an email you verified there.
BREVO_API_KEY=

# Telegram bot (optional). Get the token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Free tries for the top players each month (1st,2nd,3rd,4th) and points needed to win
LB_REWARDS=100,75,50,25
LB_MIN_POINTS=20
